amends "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Builtins.pkl"

steps {
  // Code
  ["oxlint"] = (Builtins.ox_lint) {
    // Oxlint's allocator keeps one pool per worker thread. On a small CI runner the whole tree
    // plus the js-plugin bridge is enough to exhaust a pool, which panics inside Oxlint
    // (`oxc_allocator::pool::fixed_size`).
    check = new CommandSpec {
      command = new Command {
        argv = List("oxlint", "--deny-warnings", "--threads=1", "{{files}}")
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("oxlint", "--deny-warnings", "--fix", "--threads=1", "{{files}}")
      }
      effect = "write"
    }
  }
  ["eslint"] = (Builtins.eslint) {
    batch = false
    glob =
      List(
        // Code
        "**/*.js",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.jsx",
        "**/*.ts",
        "**/*.mts",
        "**/*.cts",
        "**/*.tsx",
        // Configurations
        "*.json",
        "**/*.json5",
        "**/*.jsonc",
        "**/*.yaml",
        "**/*.yml",
        "**/*.toml",
        // Documentations
        "**/*.markdown",
        "**/*.md",
        "**/*.mdc",
        "**/*.mdx",
      )
    check = new CommandSpec {
      command = new Command { argv = List("eslint", "--no-warn-ignored", "{{files}}") }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("eslint", "--no-warn-ignored", "--fix", "{{files}}")
      }
      effect = "write"
    }
    depends = List("oxlint")
  }
  ["oxfmt"] = (Builtins.oxfmt) {
    // Formatting runs last: ESLint's fixes are the ones that can leave a file unformatted, and no
    // rule of this repository's config reports what oxfmt would only reformat.
    depends = List("eslint")
  }

  // Configurations
  ["stylua"] = Builtins.stylua
  ["hk"] {
    glob = List("hk.pkl")
    check = new CommandSpec {
      command = new Command { argv = List("hk", "validate") }
      effect = "read"
    }
  }
  ["pkl-format"] = (Builtins.pkl_format) {
    shell = null
    fix = new CommandSpec {
      command = new Command { argv = List("pkl", "format", "--write", "{{ files }}") }
      effect = "write"
    }
  }
}
